# SitePulse backend configuration
# Copy this file to .env and fill in secrets. Never commit .env.

PORT=8080
HOST=127.0.0.1

# PostgreSQL — use DATABASE_URL OR the PG* variables below
DATABASE_URL=
PGHOST=127.0.0.1
PGPORT=5432
PGUSER=
PGPASSWORD=
PGDATABASE=sitepulse
PGSSL=false
PGPOOL_MAX=10

# SMTP — credentials stay on the server; the browser never receives them
# EmailJS with Gmail (free, low-volume delivery to any recipient)
EMAILJS_SERVICE_ID=
EMAILJS_TEMPLATE_ID=
EMAILJS_PUBLIC_KEY=
EMAILJS_PRIVATE_KEY=
EMAILJS_REPLY_TO=
# Resend is recommended on Render Free because it uses HTTPS rather than SMTP.
RESEND_API_KEY=
RESEND_FROM=SitePulse <notifications@your-verified-domain.com>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Only needed if the frontend is hosted on a different origin.
# For same-origin localhost deployment, leave blank.
CORS_ORIGIN=

MAX_BODY_BYTES=102400
RATE_LIMIT_MAX=30
